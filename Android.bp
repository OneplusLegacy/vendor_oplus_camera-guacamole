    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

// ---------------------------------------------------------------------------
// Camera JNI libraries (my_product/lib64 in stock)
//
// These are dlopen()ed by the camera app, not linked, so they only need to
// land in system_ext/lib64 with their stock names.
//
// libmpbase is deliberately NOT shipped here. The sm8150-common vendor tree
// already defines a libmpbase module from vendor/lib64 and installs it, and
// the camera app prefers its own APK-bundled copy at runtime. Shipping a
// second module with the same name from this repository would be a duplicate
// Soong module.
// ---------------------------------------------------------------------------

