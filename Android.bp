//
// Stock OnePlus 7 Pro camera and gallery, from GM1911_11.H.41
// (ColorOS 12.1 / Android 12).
//
// MODULE NAMING
//
// The 13T port in vendor/oplus/camera ships libraries whose Soong module names
// match these (libcsextimpl and vendor.oplus.hardware.cameraMDM@1.0 today).
// Soong rejects duplicate module names across the whole tree, so every prebuilt
// module here carries a guacamole_ prefix. The installed file name stays the
// stock one, because cameraserver and the extension load them by name; only the
// Soong module name changed.
//
// Installed at system_ext/priv-app because this tree has no /my_product or
// /my_bigball partition. The stock layout was:
//   /my_product/priv-app/OnePlusCamera        com.oneplus.camera
//   /my_product/priv-app/OnePlusCameraService com.oneplus.camera.service
//   /my_bigball/priv-app/OnePlusGallery       com.oneplus.gallery
// Merging them under system_ext keeps the three packages on one partition and
// lets system_ext_specific prebuilts resolve their libraries normally.
//
// Signing: stock signs all three with the OnePlus release key
// (SHA-256 46:81:AD:50:CA:FC:58:0E:DF:E0:27:BD:3F:E5:93:25:
//           4E:72:CD:2D:EF:1B:35:1F:EA:30:6C:CF:62:20:CF:07).
// OnePlusCameraService declares sharedUserId android.uid.system, which only
// works with the platform certificate, so all three are re-signed with the
// platform key. This matches how the 13T port handles the same situation.
//
// Aperture and Camera2 are overridden so the stock camera is the only camera
// app on the launcher. GoogleCameraGo is listed as well because PixelOS ships
// it on some builds.
//

soong_namespace {
}

// Stock camera app.
android_app_import {
    name: "OnePlusCamera",
    owner: "oneplus",
    apk: "proprietary/system_ext/priv-app/OnePlusCamera/OnePlusCamera.apk",
    overrides: [
        "Aperture",
        "Camera2",
        "GoogleCameraGo",
    ],
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

// Persistent helper that force-stops camera clients. Stock runs it as
// android.uid.system, so it has to stay platform-signed and privileged.
android_app_import {
    name: "OnePlusCameraService",
    owner: "oneplus",
    apk: "proprietary/system_ext/priv-app/OnePlusCameraService/OnePlusCameraService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

// Stock gallery.
android_app_import {
    name: "OnePlusGallery",
    owner: "oneplus",
    apk: "proprietary/system_ext/priv-app/OnePlusGallery/OnePlusGallery.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

// ---------------------------------------------------------------------------
// Camera extension library
//
// libcsextimpl.so is loaded by cameraserver through the CameraService patch in
// vendor/extraPatches (frameworks/av/0001-CameraService-Add-OnePlus-camera-
// extension-support.patch). It exports getExtFactoryImpl and
// CameraServiceExtImpl::onTransact and hardcodes "com.oneplus.camera" for the
// privileged package check, so it is the correct library for this device (the
// 13T build of the same file targets com.oplus.camera and a newer AOSP).
//
// It links against vendor.oplus.hardware.cameraMDM@1.0/@2.0,
// vendor.oplus.hardware.commondcs@1.0 and vendor.oplus.hardware.performance@1.0.
// The first three live in system_ext/lib64 on stock; performance@1.0 is a HIDL
// library that stock keeps in system/lib64 and this tree only replaced with an
// AIDL build under a different SONAME, so it is shipped here too.
// ---------------------------------------------------------------------------

cc_prebuilt_library_shared {
    name: "guacamole_libcsextimpl",
    // The module name is prefixed to avoid a Soong collision; the installed
    // file has to keep the stock name because the camera and cameraserver load
    // it by that name.
    stem: "libcsextimpl",
    owner: "oneplus",
    strip: {
        none: true,
    },
    srcs: ["proprietary/system_ext/lib64/libcsextimpl.so"],
    shared_libs: [
        "libbase",
        "libexif",
        "libui",
        "liblog",
        "libutilscallstack",
        "libutils",
        "libbinder",
        "libcutils",
        "libmedia",
        "libmediautils",
        "libcamera_client",
        "libcamera_metadata",
        "libdynamic_depth",
        "libfmq",
        "libgui",
        "libhardware",
        "libhidlbase",
        "libimage_io",
        "libjpeg",
        "libmedia_codeclist",
        "libmedia_omx",
        "libmemunreachable",
        "libsensorprivacy",
        "libstagefright",
        "libstagefright_foundation",
        "libxml2",
        "libyuv",
        "android.frameworks.cameraservice.common@2.0",
        "android.frameworks.cameraservice.service@2.2",
        "android.frameworks.cameraservice.device@2.0",
        "android.hardware.camera.common@1.0",
        "android.hardware.camera.provider@2.7",
        "android.hardware.camera.device@3.6",
        "android.frameworks.sensorservice@1.0",
        "android.hardware.sensors@1.0",
        "guacamole_vendor.oplus.hardware.cameraMDM@1.0",
        "guacamole_vendor.oplus.hardware.cameraMDM@2.0",
        "guacamole_vendor.oplus.hardware.commondcs@1.0",
        "libcameraservice",
        "libnativewindow",
        "libvndksupport",
        "android.hardware.thermal@1.0",
        "guacamole_vendor.oplus.hardware.performance@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "guacamole_vendor.oplus.hardware.cameraMDM@1.0",
    // The module name is prefixed to avoid a Soong collision; the installed
    // file has to keep the stock name because the camera and cameraserver load
    // it by that name.
    stem: "vendor.oplus.hardware.cameraMDM@1.0",
    owner: "oneplus",
    strip: {
        none: true,
    },
    srcs: ["proprietary/system_ext/lib64/vendor.oplus.hardware.cameraMDM@1.0.so"],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "guacamole_vendor.oplus.hardware.cameraMDM@2.0",
    // The module name is prefixed to avoid a Soong collision; the installed
    // file has to keep the stock name because the camera and cameraserver load
    // it by that name.
    stem: "vendor.oplus.hardware.cameraMDM@2.0",
    owner: "oneplus",
    strip: {
        none: true,
    },
    srcs: ["proprietary/system_ext/lib64/vendor.oplus.hardware.cameraMDM@2.0.so"],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

// HIDL performance interface.
//
// libcsextimpl.so has a DT_NEEDED entry for
// vendor.oplus.hardware.performance@1.0.so. This tree only provides the AIDL
// replacement (vendor.oplus.hardware.performance-V1-ndk), whose SONAME differs,
// so the HIDL library has to be shipped from the stock blob or the extension
// cannot link.
cc_prebuilt_library_shared {
    name: "guacamole_vendor.oplus.hardware.performance@1.0",
    // The module name is prefixed to avoid a Soong collision; the installed
    // file has to keep the stock name because the camera and cameraserver load
    // it by that name.
    stem: "vendor.oplus.hardware.performance@1.0",
    owner: "oneplus",
    strip: {
        none: true,
    },
    srcs: ["proprietary/system_ext/lib64/vendor.oplus.hardware.performance@1.0.so"],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "guacamole_vendor.oplus.hardware.commondcs@1.0",
    // The module name is prefixed to avoid a Soong collision; the installed
    // file has to keep the stock name because the camera and cameraserver load
    // it by that name.
    stem: "vendor.oplus.hardware.commondcs@1.0",
    owner: "oneplus",
    strip: {
        none: true,
    },
    srcs: ["proprietary/system_ext/lib64/vendor.oplus.hardware.commondcs@1.0.so"],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    prefer: true,
    system_ext_specific: true,
}

// FastRPC opens Hexagon images through filesystem paths, not APK zip entries.
python_binary_host {
    name: "guacamole_camera_extract_dsp",
    main: "tools/extract-dsp.py",
    srcs: ["tools/extract-dsp.py"],
}

genrule {
    name: "guacamole_camera_snpe_dsp_domains_skel_extract",
    tools: ["guacamole_camera_extract_dsp"],
    srcs: ["proprietary/system_ext/priv-app/OnePlusCamera/OnePlusCamera.apk"],
    out: ["libsnpe_dsp_domains_skel.so"],
    cmd: "$(location guacamole_camera_extract_dsp) $(in) lib/arm64-v8a/libsnpe_dsp_domains_skel.so $(out) 9a35706b0e5bf710c0f45add04c7c0b6bed6f344e5eeb457b0719fb7d2bbb4b8",
}

prebuilt_rfsa {
    name: "guacamole_camera_snpe_dsp_domains_skel",
    owner: "oneplus",
    src: ":guacamole_camera_snpe_dsp_domains_skel_extract",
    filename: "libsnpe_dsp_domains_skel.so",
    sub_dir: "adsp",
    soc_specific: true,
}

genrule {
    name: "guacamole_camera_snpe_dsp_skel_extract",
    tools: ["guacamole_camera_extract_dsp"],
    srcs: ["proprietary/system_ext/priv-app/OnePlusCamera/OnePlusCamera.apk"],
    out: ["libsnpe_dsp_skel.so"],
    cmd: "$(location guacamole_camera_extract_dsp) $(in) lib/arm64-v8a/libsnpe_dsp_skel.so $(out) cc509048df51bc35816c169b3332d8895aebd64d096b7867e28bf337728f852b",
}

prebuilt_rfsa {
    name: "guacamole_camera_snpe_dsp_skel",
    owner: "oneplus",
    src: ":guacamole_camera_snpe_dsp_skel_extract",
    filename: "libsnpe_dsp_skel.so",
    sub_dir: "adsp",
    soc_specific: true,
}

genrule {
    name: "guacamole_camera_snpe_dsp_v65_domains_v2_skel_extract",
    tools: ["guacamole_camera_extract_dsp"],
    srcs: ["proprietary/system_ext/priv-app/OnePlusCamera/OnePlusCamera.apk"],
    out: ["libsnpe_dsp_v65_domains_v2_skel.so"],
    cmd: "$(location guacamole_camera_extract_dsp) $(in) lib/arm64-v8a/libsnpe_dsp_v65_domains_v2_skel.so $(out) f98cce4b9ad23b5d10488bf0cb1e465a4336bba4befd0537058625b859c676de",
}

prebuilt_rfsa {
    name: "guacamole_camera_snpe_dsp_v65_domains_v2_skel",
    owner: "oneplus",
    src: ":guacamole_camera_snpe_dsp_v65_domains_v2_skel_extract",
    filename: "libsnpe_dsp_v65_domains_v2_skel.so",
    sub_dir: "adsp",
    soc_specific: true,
}

genrule {
    name: "guacamole_camera_snpe_dsp_v66_domains_v2_skel_extract",
    tools: ["guacamole_camera_extract_dsp"],
    srcs: ["proprietary/system_ext/priv-app/OnePlusCamera/OnePlusCamera.apk"],
    out: ["libsnpe_dsp_v66_domains_v2_skel.so"],
    cmd: "$(location guacamole_camera_extract_dsp) $(in) lib/arm64-v8a/libsnpe_dsp_v66_domains_v2_skel.so $(out) 4f2b7c5983a89be3ce1e031b402970bb653c79f1704850d1df47828e57e54d97",
}

prebuilt_rfsa {
    name: "guacamole_camera_snpe_dsp_v66_domains_v2_skel",
    owner: "oneplus",
    src: ":guacamole_camera_snpe_dsp_v66_domains_v2_skel_extract",
