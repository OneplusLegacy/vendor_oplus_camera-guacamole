#
# Domain for the stock OnePlus 7 Pro camera and gallery.
#
# The stock 7 Pro build gives com.oneplus.camera the ordinary priv_app domain:
# there is no com.oneplus.camera entry in its seapp_contexts, only
# com.oplus.camera gets opluscamera_app. This port still defines a dedicated
# domain, following the 13T port, so the camera-specific access stays out of
# every other privileged app.
#
# The domain is declared here in system_ext public policy because the apps are
# installed on system_ext. Stock OxygenOS 12.1 declares its own
# opluscamera_app in system_ext policy as well (system_ext_sepolicy.cil), with
# coredomain, appdomain and mlstrustedsubject all assigned. The coredomain and
# appdomain attributes are added in the private policy file; mlstrustedsubject
# has to be part of the type declaration because it is matched before the
# macro expansion.
#

type opluscamera_app, domain, mlstrustedsubject;
type opluscamera_app_data_file, file_type, data_file_type, app_data_file_type;
