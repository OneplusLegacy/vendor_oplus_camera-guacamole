# Treble labelling requires every system_ext platform app to carry a coredomain
# type. Declare it here, in system_ext private policy, as stock OxygenOS does.
typeattribute opluscamera_app coredomain;

# app_domain() supplies the rest of the identity that the framework expects of
# an app process: the appdomain attribute, the userfaultfd anon_inode type and
# its transition, the appdomain_tmpfs transition, and the ptrace/io_uring
# neverallows that keep the domain isolated from every other app.
#
# The appdomain attribute is the important one. zygote hands app processes to
# their target domain with a dyntransition, and zygote.te only carries
# "allow zygote appdomain:process dyntransition". Without appdomain the
# dyntransition is denied and the app never starts, so a build that passes the
# neverallow check would still fail at runtime.
#
# It is also what makes the vendor data and vendor library access below legal.
# The /data/vendor and vendor_file_type neverallows in domain.te exempt
# appdomain, which is why stock OxygenOS keeps opluscamera_app in appdomain and
# grants it vendor_camera_data_file and vendor_file directly instead of relying
# on a violator attribute.
#
# Stock calls app_domain() on opluscamera_app and net_domain() alongside it.
app_domain(opluscamera_app)
net_domain(opluscamera_app)

# Own data directory. Stock grants exactly the directory and file create sets
# and nothing for lnk_file/sock_file/fifo_file, so this matches it. The label is
# opluscamera_app_data_file rather than app_data_file because a
# mlstrustedsubject may not touch the shared app data types; app.te excludes
# mlstrustedsubject from its sandbox grants for the same reason.
allow opluscamera_app opluscamera_app_data_file:dir create_dir_perms;
allow opluscamera_app opluscamera_app_data_file:file create_file_perms;

# Binder infrastructure.
binder_use(opluscamera_app);
binder_call(opluscamera_app, system_server);
binder_call(opluscamera_app, surfaceflinger);
binder_call(opluscamera_app, statsd);
# The OnePlus camera extension service is published by cameraserver side code;
# the app only needs to reach cameraserver itself, granted below.
#
# system_suspend is deliberately NOT granted. The 13T policy lists it for its
# APS implementation, but the 7 Pro camera dex has no SystemSuspend reference at
# all, so on this device the rule would only widen the domain.

# Media and storage, same shape as platform_app.
allow opluscamera_app mnt_media_rw_file:dir r_dir_perms;
allow opluscamera_app sdcard_type:dir create_dir_perms;
allow opluscamera_app sdcard_type:file create_file_perms;
allow opluscamera_app rootfs:dir getattr;
allow opluscamera_app proc_vmstat:file r_file_perms;
r_dir_file(opluscamera_app, proc_net_type)

# FastRPC, the shared camera directory and the vendor camera properties are all
# vendor types, so those rules live in sepolicy/vendor/camera_data.te: system_ext
# policy cannot reference a type that only the vendor policy declares.

# Properties the camera reads.
get_prop(opluscamera_app, audio_config_prop)
get_prop(opluscamera_app, qemu_hw_prop)

# Framework services.
allow opluscamera_app app_api_service:service_manager find;
allow opluscamera_app audioserver_service:service_manager find;
allow opluscamera_app cameraserver_service:service_manager find;
allow opluscamera_app drmserver_service:service_manager find;
allow opluscamera_app mediadrmserver_service:service_manager find;
allow opluscamera_app mediaextractor_service:service_manager find;
allow opluscamera_app mediametrics_service:service_manager find;
allow opluscamera_app mediaserver_service:service_manager find;
allow opluscamera_app radio_service:service_manager find;
allow opluscamera_app vr_manager_service:service_manager find;
allow opluscamera_app nfc_service:service_manager find;

# system_server UDP socket, same as platform_app.
allow opluscamera_app system_server:udp_socket {
    getattr read recvfrom write getopt setopt };

# The camera app's own data lives under /data/data/com.oneplus.camera by way of
# the app_data_file_type above; the gallery additionally writes decoded
# thumbnails, which is covered by the same perms.

# Quiet noisy denials from optional interfaces this device does not publish.
dontaudit opluscamera_app debugfs_tracing:file rw_file_perms;
dontaudit opluscamera_app default_android_service:service_manager find;
