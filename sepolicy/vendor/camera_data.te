#
# Vendor-side policy for opluscamera_app.
#
# The app domain is declared in system_ext policy because the camera and gallery
# are installed on system_ext, but every type it needs here only exists in
# vendor policy: /data/vendor/camera is vendor_camera_data_file, the DSP devices
# and the FastRPC directory come from the Qualcomm tree, and the camera
# properties are vendor_camera_prop. System_ext policy cannot reference a type
# that only the vendor policy declares, so these rules live on this side, the
# same way the 13T port splits its camera domain across the two policies.
#
# The permission sets below are copied from stock OxygenOS 12.1's
# system_ext_sepolicy.cil, which grants opluscamera_app exactly:
#
#   vendor_camera_data_file  dir  ioctl/read/write/create/getattr/lock/append/
#                                 map/open/watch/watch_reads/add_name/
#                                 remove_name/search/rmdir
#                                file read/write/create/getattr/setattr/lock/
#                                 append/unlink/rename/open
#   vendor_qdsp_device       chr_file ioctl/read/write/open
#   vendor_xdsp_device       chr_file ioctl/read/getattr/lock/map/open/
#                                 watch/watch_reads
#   adsprpcd_file            dir  getattr/search
#   vendor_camera_prop       file read/getattr/map/open
#
# Staying with these exact sets matters: vendor_camera_data_file is a
# data_file_type, and the coredomain data_file_type neverallow in domain.te
# exempts appdomain, so the access is legal precisely because opluscamera_app
# carries appdomain (see sepolicy/private/opluscamera_app.te).
#

# Shared APS tuning output, OCCE shader cache and watermark output. The camera
# hardcodes /data/vendor/camera/watermark and writes there itself, so it needs
# write access to both the directory and the files it creates.
allow opluscamera_app vendor_camera_data_file:dir {
    ioctl read write create getattr lock append map open watch watch_reads
    add_name remove_name search rmdir };
allow opluscamera_app vendor_camera_data_file:file {
    read write create getattr setattr lock append unlink rename open };

# FastRPC. The camera bundles libsnpe_adsp, libhta and the SNPE DSP domains,
# which link against the vendor libadsprpc/libcdsprpc and open the DSP devices.
# The libraries themselves carry same_process_hal_file, which app.te already
# lets every app map, so only the devices and the dsp directory need a grant.
allow opluscamera_app vendor_qdsp_device:chr_file { ioctl read write open };
allow opluscamera_app vendor_xdsp_device:chr_file {
    ioctl read getattr lock map open watch watch_reads };
allow opluscamera_app adsprpcd_file:dir { getattr search };

# persist.vendor.camera.* (bokeh debug masks, logic count) and the Oplus camera
# property block. vendor_camera_prop is a vendor_restricted_property_type, which
# property.te exempts from the coredomain property neverallow, so this is legal
# even though the domain is coredomain.
allow opluscamera_app vendor_camera_prop:file { read getattr map open };

# init creates /data/vendor/camera on post-fs-data and cameraserver only reads
# vendor_camera_prop, so neither needs a rule here. Stock grants init nothing
# beyond init.te's generic file_type mkdir/chown/restorecon set, and its only
# cameraserver camera grant is the property read above.
