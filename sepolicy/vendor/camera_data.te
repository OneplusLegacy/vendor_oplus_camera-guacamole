#
# Vendor-side policy for the shared camera state directory.
#
# /data/vendor/camera holds the APS tuning output and the OCCE shader cache. It
# is created by configs/init/init.oneplus.camera.rc and labelled
# oplus_camera_data_file by sepolicy/private/file_contexts.
#
# Only two domains actually touch it on this device:
#
#   init               creates the directory tree on post-fs-data
#   cameraserver       hosts the camera provider in-process, runs the OnePlus
#                      extension (libcsextimpl) and drives the OCCE pipeline
#
# The 7 Pro has no qcamera-daemon: stock launches
# android.hardware.camera.provider@2.4-service_64, which registers into
# cameraserver rather than running as a separate daemon, so there is no
# qcamera-daemon or mm-qcamerad domain to grant.
#
# opluscamera_app (the camera and gallery apps) is granted the same access from
# sepolicy/private/opluscamera_app.te, because that file sits in the
# system_ext policy where the app domain is defined.
#

# init creates the directory tree.
allow init oplus_camera_data_file:dir create_dir_perms;
allow init oplus_camera_data_file:file create_file_perms;

# cameraserver writes the tuning output and the shader cache.
allow cameraserver oplus_camera_data_file:dir create_dir_perms;
allow cameraserver oplus_camera_data_file:file create_file_perms;
allow cameraserver oplus_camera_data_file:{ lnk_file sock_file fifo_file } create_file_perms;
